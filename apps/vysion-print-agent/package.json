{
  "name": "vysion-print-agent",
  "version": "2.0.21-pilot",
  "private": true,
  "author": "Vysion Horeca",
  "description": "Lokale USB/Windows bonprinter voor Ordervysion — dubbelklik installer, geen npm op de kassa.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "pack:win": "electron-builder --win dir --x64 --publish never",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "dist:inno": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-inno-installer.ps1"
  },
  "build": {
    "appId": "com.vysionhoreca.printagent",
    "productName": "Vysion Print Agent",
    "executableName": "Vysion Print Agent",
    "directories": {
      "output": "dist",
      "buildResources": "nsis-include"
    },
    "files": [
      "main.js",
      "server.js",
      "logger.js",
      "print-queue.js",
      "cloud-print-worker.js",
      "pilot-cloud-defaults.js",
      "print-raw.ps1",
      "open-drawer.ps1",
      "watchdog.vbs",
      "preload.js",
      "kassa-preload.js",
      "settings.html",
      "td80-qr.js",
      "vendor/**",
      "assets/**"
    ],
    "asarUnpack": [
      "print-raw.ps1",
      "open-drawer.ps1",
      "watchdog.vbs"
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "include": "nsis-include/installer.nsh"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "ipad print instal rudi.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "qrcode": "^1.5.4"
  }
}
