# ─────────────────────────────────────────────────────────────────────────────
# Voorbeeld voor `.env.local`: kopieer naar `.env.local` en vul onderaan de drie waarden in.
# Alleen `.env.local.example` hoort in git; jouw echte `.env.local` met codes staat in .gitignore.
#
# Stappen:
# 1. Supabase Dashboard → je project → Project Settings (tandwiel) → API
# 2. "Project URL" kopiëren → hieronder bij NEXT_PUBLIC_SUPABASE_URL
# 3. Key "anon" / "public" kopiëren → NEXT_PUBLIC_SUPABASE_ANON_KEY
# 4. Key "service_role" (Reveal) kopiëren → SUPABASE_SERVICE_ROLE_KEY
# 5. Opslaan, daarna `npm run dev` opnieuw starten
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://VERVANG-DIT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=VERVANG-DIT-PLAK-ANON-KEY-HIER
SUPABASE_SERVICE_ROLE_KEY=VERVANG-DIT-PLAK-SERVICE-ROLE-HIER

# Zoho SMTP — NIET wijzigen naar @vysion-kassa.com zolang die mailbox niet bestaat.
# Productie (Vercel): ZOHO_EMAIL=info@vysionhoreca.com + bestaand ZOHO_PASSWORD
# ZOHO_EMAIL=info@vysionhoreca.com
# ZOHO_PASSWORD=

# Stilletjes kassa-dagrapport (cron 22:00 België) — alleen superadmin/cron, niet zichtbaar in kassa
# KASSA_DAILY_AUDIT_EMAIL=rudiaerden19@gmail.com
# KASSA_DAILY_AUDIT_TENANT_SLUGS=blonkys-restaurant,blonkyseethuis

# Optioneel: Sentry performance traces (0–1). Zonder dit: 10% in production, 100% in development.
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Pinautomaten — zaak klikt “Verbinden met …” (OAuth). Zonder deze apps blijven de knoppen uit.
# Redirect URI in elk dashboard: https://www.vysion-kassa.com/api/kassa/payment-terminal/oauth/callback
# STRIPE_CONNECT_CLIENT_ID=ca_...
# STRIPE_SECRET_KEY=sk_live_...   # platform-account (token-exchange), niet de zaak-key
# SUMUP_CLIENT_ID=
# SUMUP_CLIENT_SECRET=
# MOLLIE_CLIENT_ID=app_...
# MOLLIE_CLIENT_SECRET=

# Vysion Music (Soundtrack BFF — alleen server-side, nooit in git)
# VYSION_MUSIC_DEV_BYPASS_AUTH=1              # alleen lokaal: /dev/vysion-music zonder admin-login
# SOUNDTRACK_API_BASIC=...                    # token zonder "Basic " prefix, geen punt na ==
# SOUNDTRACK_DEFAULT_ZONE_NAME=Vysion kassa's # zone-naam in Soundtrack (wordt via API opgezocht)
# SOUNDTRACK_DEFAULT_SOUND_ZONE_ID=...        # alternatief: vaste GraphQL zone-id
#
# Spotify-import (Vysion Music — playlist-URL → Soundtrack-catalogus)
# Dashboard: https://developer.spotify.com/dashboard → app → Client ID + Secret
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Billit dagomzet (pilot: alleen tenant thelagoon, na Z-sluiting) — server-only, Vercel production
# BILLIT_THELAGOON_CLIENT_ID=
# BILLIT_THELAGOON_CLIENT_SECRET=
# BILLIT_THELAGOON_SANDBOX=1
# BILLIT_THELAGOON_API_BASE=https://api.sandbox.billit.be
# BILLIT_THELAGOON_GRANT_TYPE=client_credentials
